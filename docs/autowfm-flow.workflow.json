{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "AutoWFM 客服运营数据平台 · 完整流程",
    "output": "docs/autowfm-flow.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "guard", "label": "守护与调度" },
    { "id": "collect", "label": "采集" },
    { "id": "exception", "label": "异常与自愈", "variant": "exception" },
    { "id": "store", "label": "存储" },
    { "id": "process", "label": "口径加工" },
    { "id": "serve", "label": "消费" },
    { "id": "deliver", "label": "推送" }
  ],
  "phases": [
    { "id": "trigger", "label": "守护与触发", "fromCol": 0, "toCol": 1 },
    { "id": "ingest", "label": "采集与落库", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "consume", "label": "口径与消费", "fromCol": 4, "toCol": 4 },
    { "id": "push", "label": "推送与输出", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["mgr", "sched", "ws", "db", "metrics", "notify"],
  "nodes": [
    { "id": "mgr", "lane": "guard", "col": 0, "type": "backend", "label": "AutoWFM", "sublabel": "管理器 · 守护子进程", "width": 96 },
    { "id": "sched", "lane": "guard", "col": 2, "type": "backend", "label": "周期调度", "sublabel": "APScheduler", "width": 116 },
    { "id": "ws", "lane": "collect", "col": 2, "type": "backend", "label": "WS 实时采集", "sublabel": "collector/ws.py", "width": 116 },
    { "id": "detail", "lane": "collect", "col": 3, "type": "backend", "label": "CRM 明细导出", "sublabel": "collector/detail.py", "width": 110 },
    { "id": "token", "lane": "exception", "col": 4, "type": "security", "label": "Token 自动刷新", "sublabel": "刷新并重试一次", "width": 116 },
    { "id": "db", "lane": "store", "col": 2, "type": "database", "label": "SQLite 库", "sublabel": "每源一库 · data/*.db", "width": 116 },
    { "id": "fcsv", "lane": "store", "col": 5, "type": "database", "label": "预估流入量", "sublabel": "data/预估流入量.csv", "width": 100 },
    { "id": "metrics", "lane": "process", "col": 4, "type": "backend", "label": "指标口径", "sublabel": "collector/metrics.py", "width": 100 },
    { "id": "api", "lane": "serve", "col": 2, "type": "backend", "label": "只读 API", "sublabel": "FastAPI :8081", "width": 116 },
    { "id": "dash", "lane": "serve", "col": 5, "type": "frontend", "label": "看板", "sublabel": "Flask :8080", "width": 100 },
    { "id": "notify", "lane": "deliver", "col": 4, "type": "messagebus", "label": "企微推送", "sublabel": "collector/notify.py", "width": 100 }
  ],
  "edges": [
    { "from": "mgr", "to": "sched", "label": "拉起采集器", "role": "main", "variant": "emphasis" },
    { "from": "sched", "to": "ws", "label": "每 5 分钟", "role": "main" },
    { "from": "sched", "to": "detail", "label": "每 5 分钟", "role": "main" },
    { "from": "ws", "to": "db", "label": "repository.insert", "role": "main" },
    { "from": "detail", "to": "db", "label": "按组计数", "role": "main", "labelDy": 24 },
    { "from": "detail", "to": "token", "label": "登录态失效", "role": "error", "variant": "dashed" },
    { "from": "db", "to": "metrics", "label": "只读取数", "role": "main" },
    { "from": "fcsv", "to": "metrics", "label": "累计预估量", "role": "branch" },
    { "from": "metrics", "to": "dash", "label": "看板聚合", "role": "main" },
    { "from": "db", "to": "api", "label": "只读消费", "role": "branch" },
    { "from": "metrics", "to": "notify", "label": "定时报表", "role": "main" },
    { "from": "dash", "to": "notify", "label": "全页截图", "role": "main" }
  ],
  "cards": [
    { "dot": "cyan", "title": "采集与落库", "items": [
      "collector/ws.py 单屏单帧采集 7 路源，失败源延迟 5s 补采一次",
      "collector/detail.py 下载 CRM Excel，按组前缀折叠计数，空表跳过不覆盖",
      "collector/repository.py 每源一个 SQLite 库、一张表 t，列名即 SCHEMAS"
    ] },
    { "dot": "emerald", "title": "消费与推送", "items": [
      "看板 :8080 与 API :8081 都直连 data/*.db，两者互不调用",
      "collector/metrics.py 是流入率/接通率与卡片拼装的唯一实现",
      "每 15 分钟推送 markdown 报表 + 看板全页截图到两路企微 webhook"
    ] },
    { "dot": "amber", "title": "辅助子系统与自愈", "items": [
      "peakflow 每天 09:30 预测未来 30 天，shift 排班由管理器纯手动启动",
      "member_limit 用 Playwright 批量改腾讯云联络中心成员接待上限",
      "管理器在 05:00 静默清理过期日志；连续 3 次启动失败即熔断并弹窗告警"
    ] }
  ]
}
