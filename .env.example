# AutoWFM 本地密钥配置(本文件不入库;复制为 .env 后填入真实值)
# collector/_utils.py load_cfg() 读取 .env 并用这些变量覆盖 config.yaml 的空占位。

# CRM 明细导出(detail.py 用)
AUTOWFM_TOKEN=
AUTOWFM_TENEMENT_ID=

# 企微 webhook(notify.py 用)
AUTOWFM_WEBHOOK_MAIN=
AUTOWFM_WEBHOOK_SECONDARY=

# 看板 Bearer Token(dashboard/app.py 用;留空则看板无认证)
AUTOWFM_DASH_TOKEN=
# 接待上限批量修改(member_limit 模块用)
AUTOWFM_QCLOUD_ACCOUNT=
AUTOWFM_QCLOUD_PASSWORD=
